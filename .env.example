# Google Analytics 4 — get your measurement ID from analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend — for contact form email delivery (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx

# OPENAI_API_KEY=
# ANAM_API_KEY=

# Retell AI — live voice agent for the site widget (https://retellai.com)
# Server-side only: NEVER prefix these with NEXT_PUBLIC_.
RETELL_API_KEY=key_xxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxx
# Chat agent for the site chatbot widget (app/api/retell/chat)
RETELL_CHAT_AGENT_ID=agent_xxxxxxxxxxxx
# Per-industry agents for the use-cases voice orb (fall back to RETELL_AGENT_ID)
RETELL_AGENT_ID_BEAUTY_SPA=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_FINANCE_INSURANCE=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_HEALTH_WELLNESS=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_HOME_SERVICES=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_LEGAL=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_PERSONAL_SECRETARY=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_REAL_ESTATE=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_RESTAURANT=agent_xxxxxxxxxxxx
RETELL_AGENT_ID_SMALL_BUSINESS=agent_xxxxxxxxxxxx

# Upstash Redis (Vercel Marketplace) — blog comments storage.
# The marketplace install provisions these automatically (UPSTASH_* or KV_* names both work).
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# Secret used to sign the one-click approve/reject links in comment
# notification emails. Generate with: openssl rand -hex 32
COMMENT_MODERATION_SECRET=xxxxxxxxxxxx
